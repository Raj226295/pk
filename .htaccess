RewriteEngine On

# Firebase Admin credentials may live in backend/credentials on Hostinger.
# Never serve that directory, even when the JSON file itself exists.
RewriteRule (^|/)backend/credentials(?:/|$) - [F,L,NC]

# Serve locally stored uploads from the backend uploads folder. The rewrite
# target is relative to this project directory, so it works both at /pk in
# XAMPP and when the project is deployed as the document root.
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]

# Upload URLs should not fall through to the React app.
RewriteRule ^uploads/ - [R=404,L]

# Send API requests to the PHP backend.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]

# Let existing frontend assets load normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router fallback.
RewriteRule ^ index.html [QSA,L]
